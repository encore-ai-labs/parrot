<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- AVFoundation otherwise emits a false Continuity Camera deprecation
         warning while configuring a microphone-only capture session. -->
    <key>NSCameraUseContinuityCameraDeviceType</key>
    <true/>
    <key>NSMicrophoneUsageDescription</key>
    <string>Parrot uses the selected microphone for on-device dictation.</string>
</dict>
</plist>
